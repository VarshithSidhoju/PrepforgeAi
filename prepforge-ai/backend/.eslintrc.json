{
    "env": {
      "node": true,
      "es2021": true
    },
    "extends": ["eslint:recommended", "plugin:node/recommended", "prettier"],
    "parserOptions": {
      "ecmaVersion": "latest",
      "sourceType": "module"
    },
    "rules": {
      "no-console": "off",
      "node/no-unsupported-features/es-syntax": ["error", { "version": ">=18.0.0" }],
      "node/no-missing-import": "off"
    }
  }